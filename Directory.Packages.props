<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- The complete package budget. Adding anything here requires a recorded decision in AGENTS.md. -->
  <ItemGroup Label="App">
    <!-- Exact pin: the MCP SDK's AOT/serializer contract is verified against this version only. -->
    <PackageVersion Include="ModelContextProtocol" Version="[2.2.0]" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.12" />
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup Label="Test">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
    <!--
      Held at 3.x deliberately: xunit.v3 4.0.0 drops VSTest-mode support, which D11 depends on.
      See AGENTS.md, *Package budget changes*, for the evidence and the revisit trigger.
    -->
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

</Project>
