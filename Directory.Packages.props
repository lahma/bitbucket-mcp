<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- The complete package budget. Adding anything here requires a recorded decision in AGENTS.md. -->
  <ItemGroup Label="App">
    <!-- Exact pin: the MCP SDK's AOT/serializer contract is verified against this version only. -->
    <PackageVersion Include="ModelContextProtocol" Version="[2.4.0]" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.15" />
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.15" />
  </ItemGroup>

  <!-- NUnit on Microsoft.Testing.Platform (D11): NUnit3TestAdapter is the MTP runner through
       EnableNUnitRunner, and GitHubActionsTestLogger turns failures into GitHub annotations when
       the Test target passes its report-github option. -->
  <ItemGroup Label="Test">
    <PackageVersion Include="NUnit" Version="5.0.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.3.1" />
    <PackageVersion Include="NUnit.Analyzers" Version="4.15.0" />
    <PackageVersion Include="GitHubActionsTestLogger" Version="3.0.5" />
  </ItemGroup>

</Project>
