<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>bitbucket-mcp</AssemblyName>
    <RootNamespace>Bitbucket.Mcp</RootNamespace>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <EventSourceSupport>false</EventSourceSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <StripSymbols>true</StripSymbols>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <!-- Required for IDE0005 (unnecessary usings) to run under EnforceCodeStyleInBuild;
         CS1591 is silenced centrally. See https://github.com/dotnet/roslyn/issues/41640. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- D17: the NuGet channel, `dnx bitbucket-mcp`. It delivers the same Native AOT binary as the
       GitHub Releases, as RID-specific tool packages: `dotnet pack` builds the pointer package, which
       names one package per RID below; `dotnet pack -r <rid>` builds each of those on a runner of
       that OS (Native AOT does not cross-compile across operating systems); and `dotnet pack -r any
       -p:PublishAot=false` builds the framework-dependent fallback for every other platform.
       PackageType McpServer is what nuget.org filters on to show the MCP tab and generate client
       configuration; PackAsTool already makes it a tool package, so DotnetTool is deliberately NOT
       listed alongside it (the mcpserver template does the same). The SDK types the RID packages
       DotnetToolRidPackage instead, so only the pointer carries McpServer - which matters, because
       nuget.org refuses a McpServer package that is not also a DotnetTool. -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <PackageType>McpServer</PackageType>
    <PackageId>bitbucket-mcp</PackageId>
    <ToolCommandName>bitbucket-mcp</ToolCommandName>
    <!-- The `any` fallback package is framework-dependent, so it must keep working on a runtime
         newer than the one it was built against. -->
    <RollForward>Major</RollForward>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>mcp;mcp-server;model-context-protocol;bitbucket;bitbucket-cloud;pull-request;code-review;ai;stdio</PackageTags>
    <Description>Model Context Protocol server for Bitbucket Cloud pull requests - list, read, diff, comment, review, merge and decline - with OAuth 2.0 browser login and a deliberately small, auditable dependency tree. `dnx bitbucket-mcp` runs the Native AOT binary on Windows, Linux and macOS (x64 and Arm64 where built) and a framework-dependent build elsewhere; the same binaries are on GitHub Releases.</Description>
  </PropertyGroup>

  <!-- The RIDs the pointer package names: exactly the release matrix's five legs (ToolPackageTests
       keeps the two lists equal), plus `any` for the framework-dependent fallback. Not
       RuntimeIdentifiers (D9): this property only shapes the tool packages and restores nothing per
       RID. With it set, a RID-less `dotnet pack` builds the pointer alone, so PublishAot stays true
       for every build and the AOT analyzers with it; only the fallback's pack turns it off. The one
       cost is that a restore brings the ILCompiler pack of the host's own RID - the one a local
       SmokeTest needs anyway - and never another's. A
       published tool needs neither symbols nor the XML docs, and Native AOT's symbols alone are about
       100 MB on Windows, so neither is copied to publish output - the archives never shipped them
       either. -->
  <PropertyGroup>
    <ToolPackageRuntimeIdentifiers>linux-x64;linux-arm64;win-x64;win-arm64;osx-arm64;any</ToolPackageRuntimeIdentifiers>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <PublishDocumentationFile>false</PublishDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Packed into the package root as /.mcp/server.json, which is where nuget.org looks for the
         MCP server manifest. Both files live at the repository root - one server manifest per
         repository, and the same README.md the AOT archives ship - so they are referenced from
         there rather than duplicated under src/. -->
    <None Include="../../.mcp/server.json" Pack="true" PackagePath="/.mcp/" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <!-- Deliberately absent (D9/D10): RuntimeIdentifiers (would pull ILCompiler packs per RID on
       every restore - the RID reaches publish via -r), PublishSingleFile (ignored under AOT) and
       SelfContained (implied by PublishAot). -->

  <ItemGroup>
    <InternalsVisibleTo Include="Bitbucket.Mcp.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <!-- DPAPI for the token cache. Windows-only code path, guarded by OperatingSystem.IsWindows(). -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>

</Project>
